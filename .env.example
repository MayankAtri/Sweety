# Copy to .env in the repository root. Values below are development-only examples.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sweety:sweety_local_password@localhost:5433/sweety
# Use a separate disposable database: tests may remove its contents.
TEST_DATABASE_URL=postgresql://sweety:sweety_local_password@localhost:5433/sweety_test
CLIENT_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
# Optional smoke-test override: export in shell; the script does not load .env.
# APP_BASE_URL=http://localhost:8080
