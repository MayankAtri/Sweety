{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "npm run test:e2e --workspace server",
    "test:all": "npm test && npm run test:e2e && npm run test:client",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "test:client": "npm run test --workspace client",
    "test:docker": "node scripts/docker-smoke.mjs"
  }
}
